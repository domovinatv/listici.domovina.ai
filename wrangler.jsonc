{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listici-domovina-ai",
  // Vlastiti ulaz (src/worker.ts): Astro za HTTP; kasnije i scheduled za uvoz župa.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // D.O.M. račun — isti kao omm.domovina.ai.
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
  // Do S9 (domena) Worker živi samo na *.workers.dev; `routes` bi ga ugasio.
  "workers_dev": true,

  "assets": { "directory": "./dist", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listici-domovina-ai",
      // Privremeno (odluka 301): baza na računu još ne postoji, radi se samo --local.
      // Zamijeniti pravim ID-om iz `wrangler d1 create` u S9.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
